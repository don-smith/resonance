# Resonance process telemetry. Copy this file to .resonance/.env.
RESONANCE_TELEMETRY=langfuse
RESONANCE_TELEMETRY_LEVEL=info
RESONANCE_TELEMETRY_CAPTURE_CONTENT=true

# Local Langfuse instance.
LANGFUSE_BASE_URL=http://127.0.0.1:13000
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
