{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "The trusted main shell may use only registered shell commands and the shell-owned updater.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "allow-bundled-package-ids",
    "allow-workspace-view",
    "allow-workspace-files-v1",
    "allow-create-workspace",
    "allow-create-workspace-invite",
    "allow-join-workspace",
    "allow-retry-workspace-join"
  ]
}
