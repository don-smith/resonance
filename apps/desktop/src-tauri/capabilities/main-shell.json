{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "The trusted main shell may use registered application commands and declared package events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bundled-package-ids",
    "allow-workspace-view",
    "allow-workspace-files-v1",
    "allow-create-workspace",
    "allow-create-workspace-invite",
    "allow-join-workspace",
    "allow-retry-workspace-join"
  ]
}
