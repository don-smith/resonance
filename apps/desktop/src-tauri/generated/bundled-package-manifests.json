[
  {
    "manifestVersion": 2,
    "source": "bundled",
    "id": "resonance.reference",
    "name": "Reference package",
    "description": "A worked manifest and declared-event example.",
    "nav": { "label": "Reference", "icon": "book" },
    "content": { "entry": "src/index.ts" },
    "events": {
      "emits": ["doc:opened", "agent-context:document-selected"],
      "consumes": ["workspace:member-added"]
    },
    "minRole": "viewer",
    "capabilities": ["documents:read", "telemetry:write"],
    "agent": {
      "systemPrompt": "prompts/reference.md",
      "permissions": ["read", "suggest-edits"],
      "contextProviders": ["document-selected"]
    }
  }
]
