        createArchitectureToolsFn = code "createArchitectureTools()" {
          description """
            Creates the five LangChain tools for the architecture agent:
            read_model, read_view, read_evidence, validate_architecture, read_entity.
            Each wraps a store method with recoverable error formatting.
          """
          technology "TypeScript"
        }
        createReadonlyRepositoryBackendFn = code "createReadonlyRepositoryBackend()" {
          description """
            Creates a read-only virtual filesystem backend over the repository root
            with ls, read, readRaw, glob, grep, but no write/edit.
          """
          technology "TypeScript"
        }
        createPackagedSkillBackendFn = code "createPackagedSkillBackend()" {
          description """
            Composes a read-only multi-skill backend with a repository backend,
            routing /skills/* paths to packaged SKILL.md content and all other
            paths to bounded repository access. Writes are limited to artifactRoot
            and Markdown documents.
          """
          technology "TypeScript"
        }
        providerFetchFn = code "providerFetch()" {
          description """
            Wraps the fetch function with telemetry error logging: extracts
            provider error details and Cloudflare ray id from non-ok responses.
          """
          technology "TypeScript"
        }
        deepAgentsRuntime = code "DeepAgentsRuntime" {
          description """
            Implements ArchitectureAgentRuntime: iterates the LangGraph stream,
            yields ArchitectureAgentUpdate events (assistant text, token context),
            and tracks per-turn thread state.
          """
          technology "TypeScript"
        }
        architectureChatOpenAI = code "ArchitectureChatOpenAI" {
          description """
            ChatOpenAI subclass that resolves architecture-specific model profiles
            for token-limit awareness via getArchitectureModelProfile().
          """
          technology "TypeScript"
        }
        readOnlyRepoBackend = code "ReadonlyRepositoryBackend" {
          description """
            Virtual filesystem backend: resolves physical paths within the
            repository root, blocks symlinks and .git/sensitive paths, enforces
            a 10 MB read/write limit, and provides ls/read/glob/grep.
          """
          technology "TypeScript"
        }
        packagedSkillsType = code "PackagedSkills" {
          description """
            Union type: a string (one default skill) or a record of skill-name
            to SKILL.md content, consumed by createPackagedSkillBackend().
          """
          technology "TypeScript"
        }

        createDeepAgentsRuntimeFactoryFn -> createArchitectureToolsFn "calls"
        createDeepAgentsRuntimeFactoryFn -> createPackagedSkillBackendFn "calls"
        createDeepAgentsRuntimeFactoryFn -> architectureChatOpenAI "instantiates"
        createDeepAgentsRuntimeFactoryFn -> deepAgentsRuntime "returns"
        createDeepAgentsRuntimeFactoryFn -> providerFetchFn "wraps fetch with"

        deepAgentsRuntime -> resonancePackages.architecture.store "streams tool calls to"

        createArchitectureToolsFn -> resonancePackages.architecture.store "wraps"
        createArchitectureToolsFn -> resonancePackages.architecture.checkers "calls validate through"

        createPackagedSkillBackendFn -> createReadonlyRepositoryBackendFn "calls"
        createPackagedSkillBackendFn -> packagedSkillsType "accepts"
        createReadonlyRepositoryBackendFn -> readOnlyRepoBackend "instantiates"
      }
      renderer = component "LikeC4 diagram renderer" {
        description "React component wrapping @likec4/diagram for browser rendering with view navigation and validation panel."
        technology "TypeScript + React"
        link ./src/packages/architecture/architecture-likec4.tsx "Source"

        createLikeC4RendererFn = code "createLikeC4Renderer()" {
          description """
            Creates a React root from a DOM element, builds a LikeC4Model from
            the dump, renders ReactLikeC4 with pan/zoom/select/navigate callbacks,
            and returns an { unmount() } handle for cleanup.
          """
          technology "TypeScript + React"
        }
        rendererOptionsType = code "RendererOptions" {
          description """
            Configuration: root HTMLElement, dump (LikeC4 serialized model),
            viewId, onNodeClick callback, and onNavigate callback.
          """
          technology "TypeScript"
        }

        createLikeC4RendererFn -> rendererOptionsType "accepts"
      }
    }
  }

  developer = actor "Developer" {
    description "An individual software developer who builds and evolves software — connected through Resonance to projects and teams."
  }

  team = actor "Team" {
    description "A group of developers collaborating through shared assets, common views, and team capabilities — balanced with space for individual exploration, learning, and personal workspaces."
  }

  project = system "Project" {
    description "A software project that teams and individual developers work on. Resonance provides a common application view across otherwise disparate tools."
  }

  teamMember -> resonanceRuntime "Uses"
  resonanceRuntime -> targetRepository "Reads committed sources and configuration"
  resonanceRuntime -> resonancePackages "Provides services to"
  resonancePackages -> resonanceRuntime "Registers through"
  resonancePackages -> targetRepository "Reads committed sources and configuration"
  resonancePackages -> llmProvider "Configured packages make LLM calls through"

  developer -> resonanceRuntime "Uses Resonance to connect"
  developer -> team "Belongs to"
  team -> project "Collaborates on"
  team -> resonanceRuntime "Uses to create shared application view"
  resonanceRuntime -> project "Projects the common view onto"

  resonanceRuntime.server -> resonanceRuntime.host "Dispatches requests through"
  resonanceRuntime.server -> resonanceRuntime.member "Loads member configuration via"
  resonanceRuntime.member -> resonanceRuntime.host "Supplies member package manifests to"

  resonanceRuntime.server -> resonanceRuntime.config "Loads repository configuration from"
  resonanceRuntime.host -> resonanceRuntime.config "Reads default configuration from"

  resonanceRuntime.server -> resonanceRuntime.browser "Serves browser assets to"
  resonanceRuntime.browser -> resonanceRuntime.host "Makes API calls through"

  resonanceRuntime.member -> targetRepository "Reads member configuration from"
  resonanceRuntime.content -> targetRepository "Reads Markdown sources from"

  resonancePackages.shell -> resonanceRuntime.host "Registers through"
  resonancePackages.home -> resonanceRuntime.host "Registers through"
  resonancePackages.docs -> resonanceRuntime.host "Registers through"
  resonancePackages.backlog -> resonanceRuntime.host "Registers through"
  resonancePackages.architecture -> resonanceRuntime.host "Uses package-safe host capabilities"

  resonancePackages.home -> targetRepository "Reads landing source"
  resonancePackages.docs -> targetRepository "Reads Markdown"
  resonancePackages.backlog -> targetRepository "Reads backlog decisions"
  resonancePackages.architecture -> targetRepository "Reads LikeC4 model and evidence"
  resonancePackages.architecture -> llmProvider "Makes LLM calls through"
  resonancePackages.backlog -> llmProvider "Makes LLM calls through"

  resonancePackages.home -> resonanceRuntime.content "Uses content engine"
  resonancePackages.docs -> resonanceRuntime.content "Uses content engine"

  resonanceRuntime.server.requestRouter -> resonanceRuntime.server.assetServer "Delegates asset requests to"

  resonanceRuntime.host.registry -> resonanceRuntime.host.transport "Composes through"
  resonanceRuntime.host.registry -> resonanceRuntime.host.telemetry "Creates and injects"
  resonanceRuntime.host.registry -> resonanceRuntime.host.stateManager "Validates and creates state for"

  resonanceRuntime.content.fileDiscovery -> resonanceRuntime.content.markdownRenderer "Provides source for"

  resonancePackages.architecture.store -> resonancePackages.architecture.checkers "Provides model for"
  resonancePackages.architecture.store -> resonancePackages.architecture.agent "Provides artifacts to"
  resonancePackages.architecture.store -> resonancePackages.architecture.renderer "Provides graph data to"
  resonancePackages.architecture.agent -> resonancePackages.architecture.deepagents "Delegates tool execution to"
  resonancePackages.architecture.deepagents -> resonancePackages.architecture.store "Reads and writes artifacts through"
  resonancePackages.architecture.checkers -> resonancePackages.architecture.store "Validates model from"

  resonancePackages.backlog.store -> resonancePackages.backlog.agent "Provides decisions to"
  resonancePackages.backlog.agent -> resonancePackages.backlog.deepagents "Delegates tool execution to"
  resonancePackages.backlog.deepagents -> resonancePackages.backlog.store "Reads and writes decisions through"
}

views {
  view packageContainers {
    title "Package containers"
    description "The package containers that extend Resonance and their external dependencies."

    include
      targetRepository,
      llmProvider,
      resonanceRuntime

    include resonancePackages.*
  }

  view landscape {
    title "Landscape"
    description """
      Draft system landscape showing where Resonance sits in the broader developer ecosystem.
      Resonance connects individual developers to multiple projects, and brings developers
      together through teams — providing a common application view that replaces the
      fragmented experience of using disparate tools. AI has reduced the cost of writing
      code, making it feasible to build these shared experiences quickly, reuse templates
      and skills, and balance team-owned shared assets with space for individual exploration
      and learning.
    """
    include
      developer,
      team,
      project,
      resonanceRuntime,
      resonancePackages,
      teamMember,
      targetRepository
  }

  view systemContext of resonanceRuntime {
    title "System context"
    description "Resonance Runtime, Resonance Packages, and the context around the repository they operate on."
    include
      teamMember,
      resonanceRuntime,
      resonancePackages,
      targetRepository,
      llmProvider
  }

  view runtimeContainers of resonanceRuntime {
    title "Runtime containers"
    description "The containers that make up the Resonance Runtime and their repository boundary."

    include
      targetRepository

    include resonanceRuntime.*
  }

  view hostComponents of resonanceRuntime.host {
    title "Host components"
    description "The components inside the Host registry container."
    include *
  }

  view serverComponents of resonanceRuntime.server {
    title "Server components"
    description "The components inside the HTTP server container."
    include *
  }

  view memberComponents {
