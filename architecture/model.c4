  view requestRouterCode of resonanceRuntime.server.requestRouter {
    title "Request router"
    description """
      Request routing internals: the `createApp()` factory that wires
      the HTTP server, method validation and Allow-header computation,
      and the `startServer()` entry point.
      Shows how the router delegates asset requests to `serveFile()`.
    """

    include
      // ── Factory & entry point ────────────────────────
      createAppFn,
      startServerFn,

      // ── Method helpers ───────────────────────────────
      methodOfFn,
      registeredMethodsFn,
      allowForFn,
      rejectMethodFn,

      // ── Cross-component delegate ─────────────────────
      resonanceRuntime.server.assetServer.serveFileFn
  }

  view assetServerCode of resonanceRuntime.server.assetServer {
    title "Asset server"
    description """
      Static file serving internals: the `serveFile()` function that
      checks existence, streams files from disk with content-type and
      cache-control headers, and returns 404 on failure.
      Called by the request router during asset dispatch.
    """

    include
      serveFileFn,

      // ── Caller ───────────────────────────────────────
      resonanceRuntime.server.requestRouter.createAppFn
  }

  view configLoaderCode of resonanceRuntime.member.configLoader {
    title "Member config loader"
    description """
      Functions, types, and calling patterns inside the Member Config Loader component.
      Shows how `loadMemberConfig()` and `writeMemberConfig()` both validate through
      `validateMemberConfig()`, which produces the `MemberConfig` type.
    """

    include
      // ── Public API ──────────────────────────────────
      loadMemberConfigFn,
      writeMemberConfigFn,
      resolveMemberRepositoryFn,
      packageInputFn,

      // ── Validation entry ────────────────────────────
      validateMemberConfigFn,

      // ── Output types ────────────────────────────────
      memberConfigType
  }

  view manifestLoaderCode of resonanceRuntime.member.manifestLoader {
    title "Member manifest loader"
    description """
      Functions, types, and calling patterns inside the Member Manifest Loader component.
      Shows how `loadMemberManifest()` discovers and validates through
      `validateMemberManifest()`, producing the `MemberManifest` type.
    """

    include
      // ── Public API ──────────────────────────────────
      loadMemberManifestFn,

      // ── Validation entry ────────────────────────────
      validateMemberManifestFn,

      // ── Output types ────────────────────────────────
      memberManifestType
  }

  view scaffolderCode of resonanceRuntime.scaffolder {
    title "Member scaffolder"
    description """
      Functions, types, and calling patterns inside the Member Scaffolder component.
      Shows plan-then-create pattern for both packages and repositories:
      `planMemberPackageScaffold()` → `createMemberPackageScaffold()` and
      `planMemberRepository()` → `createMemberRepository()`.
    """

    include
      // ── Package scaffolding ─────────────────────────
      planMemberPackageScaffoldFn,
      createMemberPackageScaffoldFn,

      // ── Repository scaffolding ──────────────────────
      planMemberRepositoryFn,
      createMemberRepositoryFn,

      // ── Plan types ──────────────────────────────────
      memberPackagePlanType,
      memberRepositoryPlanType,

      // ── Callback contract ───────────────────────────
      verifyMemberPackageType
  }
