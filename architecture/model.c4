specification {
  element system
  element container
  element component {
    style {
      shape component
    }
  }
  element code {
    style {
      shape rectangle
    }
  }
  element actor {
    style {
      shape person
    }
  }
  element database {
    style {
      shape storage
    }
  }
  element browser {
    style {
      shape browser
    }
  }
}

model {
  teamMember = actor "Team member" {
    description "A team member exploring and evolving the repository."
  }

  targetRepository = database "Target repository" {
    description "The repository Resonance is operating on."
    link ./docs/architecture.md "Architecture boundaries"
  }

  llmProvider = system "LLM provider" {
    description "An external language model provider used by configured packages for agent and other AI-assisted capabilities. Resonance Runtime does not require an LLM to serve the workspace."
  }

  resonanceRuntime = system "Resonance Runtime" {
    description "The core runtime that serves the workspace HTTP server, validates and composes package contributions, and loads member packages."

    host = container "Host registry" {
      description "Validates package contributions and composes the application."
      technology "TypeScript"
      link ./src/host.ts "Source"

      registry = component "Package registry" {
        description "Loads the explicit package allowlist and validates contributions."
        technology "TypeScript"
        link ./src/host.ts "Source"

        hostRegistryType = code "HostRegistry" {
          description """
            Frozen registry shape returned by `createHost()`:
            `context`, `routes`, `assets`, `manifest`, and `dispose()`.
          """
          technology "TypeScript"
        }
        hostManifest = code "HostManifest" {
          description """
            Serialisable manifest payload:
            `version`, `repository`, `runtime`, `navigation`, `packages`, `diagnostics`.
          """
          technology "TypeScript"
        }
        createHostFn = code "createHost()" {
          description """
            Factory function: resolves repository/app roots, creates HostContext,
            iterates package definitions, validates state, registers contributions,
            assembles the frozen manifest, and returns a HostRegistry.
          """
          technology "TypeScript"
        }
        registrationValidator = code "Registration assertion helpers" {
          description """
            Path, file, route, asset, and browser assertion guards:
            `assertPath`, `assertAssetFile`, `assertRoutePath`,
            `assertAssetPath`, `assertBrowserContribution`.
          """
          technology "TypeScript"
        }
        routeKeyFn = code "routeKey()" {
          description "Derives a stable route key from method + pathname for de-duplication."
          technology "TypeScript"
        }

        isPackageRegistrationFn = code "isPackageRegistration()" {
          description "Runtime type guard: structurally checks metadata shape, route/asset/navigation arrays, and browser entry on a registration object."
          technology "TypeScript"
        }

        createContextFn = code "createContext()" {
          description "Factory for the per-package HostContext: resolves repository/app roots, injects telemetry, and installs a bounded `resolveRepositoryPath` guard."
          technology "TypeScript"
        }

        addRegistrationFn = code "addRegistration()" {
          description "Merges a validated PackageRegistration into the mutable registry: registers routes with `routeKey()`, validates asset/route uniqueness, adds navigation and browser entries, and collects disposers."
          technology "TypeScript"
        }

        mutableRegistryType = code "MutableRegistry" {
          description "Internal mutable accumulator: `context`, `routes`, `assets`, `navigation`, `packages`, `disposers`, `diagnostics` — frozen into `HostRegistry` when `createHost()` completes."
          technology "TypeScript"
        }

        packageDiagnosticType = code "PackageDiagnostic" {
          description "Per-package diagnostic entry: `scope` (team | member), `id`, `status` (disabled | failed), and `message`."
          technology "TypeScript"
        }

        createHostFn -> hostRegistryType "produces"
        createHostFn -> hostManifest "assembles"
        createHostFn -> packageDiagnosticType "collects"

        createHostFn -> createContextFn "calls"
        createHostFn -> isPackageRegistrationFn "validates with"
        createHostFn -> addRegistrationFn "delegates to"

        addRegistrationFn -> routeKeyFn "keys routes with"
        addRegistrationFn -> mutableRegistryType "mutates"
        addRegistrationFn -> registrationValidator "asserts with"

        mutableRegistryType -> hostRegistryType "freezes into"
      }
      transport = component "Package transport" {
        description "Dispatches namespaced routes and bounded package-safe requests."
        technology "TypeScript"
        link ./src/package-contract.ts "Source"

        hostContext = code "HostContext" {
          description """
            Injectable per-package context: `repositoryRoot`, `appRoot`,
            `telemetry`, optional `state`, and path-resolve guard.
          """
          technology "TypeScript"
        }
        hostRequest = code "HostRequest" {
          description """
            HTTP request abstraction: `url`, `headers`, `readJson<T>(maxBytes?)`,
            and `onAbort` listener.
          """
          technology "TypeScript"
        }
        hostResponse = code "HostResponse" {
          description """
            HTTP response abstraction: `json(status, body)`, SSE stream via
            `sse()`, and `onClose` lifecycle.
          """
          technology "TypeScript"
        }
        packageDefinition = code "PackageDefinition" {
          description """
            Contract each package implements: `metadata`, optional `scope` and
            `packageRoot`, and `register(context, input) → PackageRegistration`.
          """
          technology "TypeScript"
        }
        packageRegistration = code "PackageRegistration" {
          description """
            Struct returned by `register()`: `metadata`, `routes[]`, `assets[]`,
            `navigation[]`, `browser`, and optional `dispose`.
          """
          technology "TypeScript"
        }
        telemetryInterface = code "Telemetry" {
          description """
            Observability surface: child/session scoping, level-gated
            debug/info/warn/error, and span lifecycle (event/end/fail).
            Extended by `TelemetryController` with `flush()` + `dispose()`.
          """
          technology "TypeScript"
        }
        routeContribution = code "RouteContribution" {
          description "Single route: `method` (GET | POST), `path`, and `handler`."
          technology "TypeScript"
        }

        packageDefinition -> packageRegistration "produces"
        packageRegistration -> hostContext "receives"
        packageRegistration -> routeContribution "contains"
        hostRequest -> hostResponse "paired with"
        hostContext -> telemetryInterface "references"
      }
      telemetry = component "Telemetry" {
        description "Structured logging and span export (console / Langfuse) with credential redaction."
        technology "TypeScript"
        link ./src/telemetry.ts "Source"

        telemetryImpl = code "TelemetryImplementation" {
          description """
            Core class implementing `TelemetryController`: child/session scoping,
            level-gated logging, span lifecycle with start/event/end/fail,
            and flush/dispose with timeout.
          """
          technology "TypeScript"
        }
        nullExporter = code "NullExporter" {
          description """
            No-op `Exporter` used when telemetry mode is `'off'`.
          """
          technology "TypeScript"
        }
        langfuseExporter = code "LangfuseExporter" {
          description """
            Batched OTLP/JSON exporter to Langfuse: microtask-scheduled flush,
            deduplicated sends, OTel trace/span ID formatting, and Basic-auth
            credential injection.
          """
          technology "TypeScript"
        }
        exporterInterface = code "Exporter" {
          description """
            Contract: `record(TelemetryRecord)` + `flush()`.
          """
          technology "TypeScript"
        }
        createTelemetryFn = code "createTelemetry()" {
          description """
            Resolves environment config (`.resonance/.env` + `process.env`),
            selects exporter (`NullExporter` | `LangfuseExporter`),
            and returns a configured `TelemetryController`.
          """
          technology "TypeScript"
        }
        sanitizeFn = code "sanitize()" {
          description """
            Recursively redacts credential keys (`secretKey` regex),
            secret value patterns (`sk-…`, `Bearer …`), and optionally
            content keys when capture is disabled.
          """
          technology "TypeScript"
        }
        envConfigFn = code "environmentConfig()" {
          description """
            Reads `.resonance/.env` and `process.env` to produce a
            `TelemetryConfig` (mode, level, Langfuse keys, capture toggle).
          """
          technology "TypeScript"
        }

        createTelemetryFn -> telemetryImpl "instantiates"
        createTelemetryFn -> langfuseExporter "optionally instantiates"
        createTelemetryFn -> nullExporter "falls back to"
        createTelemetryFn -> envConfigFn "reads"
        telemetryImpl -> exporterInterface "delegates to"
        langfuseExporter -> exporterInterface "implements"
        nullExporter -> exporterInterface "implements"
        sanitizeFn -> telemetryImpl "redacts for"
      }
      stateManager = component "State manager" {
        description "Persists per-package JSON state to .resonance/state/ with atomic writes, size validation, and corrupt-state isolation."
        technology "TypeScript"
        link ./src/state.ts "Source"

        packageStateInterface = code "PackageState" {
          description """
            Per-package JSON read/write contract:
            `read<T>()` and `write(value)`.
          """
          technology "TypeScript"
        }
        createStateFn = code "createPackageState()" {
          description """
            Creates a `PackageState` backed by `.resonance/state/<pkg>/state.json`
            with atomic write (tmp file + rename) and `PACKAGE_STATE_MAX_BYTES` cap.
          """
          technology "TypeScript"
        }
        validateStateFn = code "validatePackageState()" {
          description """
            Startup guard: parse existing state file synchronously so corrupt
            state isolates the package before routes are registered.
          """
          technology "TypeScript"
        }
        stateSerializer = code "State serializer" {
          description """
            `encode()` – JSON.stringify with 64 KiB size check.
            `parse()` – JSON.parse with size check and typed error messages.
          """
          technology "TypeScript"
        }
        stateFilenameFn = code "stateFilename()" {
          description """
            Derives the per-package state path under `.resonance/state/`
            or `.resonance/member-state/` with id validation.
          """
          technology "TypeScript"
        }

        createStateFn -> packageStateInterface "produces"
        createStateFn -> stateSerializer "uses"
        validateStateFn -> stateSerializer "uses"
        stateFilenameFn -> createStateFn "resolves path for"
        stateFilenameFn -> validateStateFn "resolves path for"
      }
    }

    server = container "HTTP server" {
      description "Creates the Node HTTP server, dispatches requests to host routes, serves assets, and manages SSE connections."
      technology "TypeScript"
      link ./src/server.ts "Source"

      requestRouter = component "Request router" {
        description "Parses incoming HTTP requests, matches method+path against registered routes and assets, and dispatches to handlers."
        technology "TypeScript"
        link ./src/server.ts "Source"

        createAppFn = code "createApp()" {
          description """
            Factory: resolves repository config, creates the Host registry,
            wires `http.createServer` with route matching, method validation,
            Allow-header computation, asset dispatch, and SSE-aware error handling.
          """
          technology "TypeScript"
        }
        startServerFn = code "startServer()" {
          description """
            Entry point: calls `createApp()`, binds to a port with
            `maxPortAttempts` retry, and logs the listening address.
          """
          technology "TypeScript"
        }
        methodOfFn = code "methodOf()" {
          description """
            Normalizes an HTTP method string to `HttpMethod` (`GET` | `POST`)
            or returns `null` for unsupported methods.
          """
          technology "TypeScript"
        }
        registeredMethodsFn = code "registeredMethods()" {
          description """
            Returns the sorted unique HTTP methods registered for a
            given pathname from the HostRegistry routes table.
          """
          technology "TypeScript"
        }
        allowForFn = code "allowFor()" {
          description """
            Computes the `Allow` header value for a pathname:
            unions registered route methods with `GET` for assets
            and the manifest endpoint.
          """
          technology "TypeScript"
        }
        rejectMethodFn = code "rejectMethod()" {
          description """
            Sends a `405 Method Not Allowed` response with the
            computed `Allow` header.
          """
          technology "TypeScript"
        }
        httpMethodType = code "HttpMethod" {
          description """
            Union type: `'GET' | 'POST'`.
            Normalized by `methodOf()` from raw HTTP method strings
            and consumed throughout the routing pipeline.
          """
          technology "TypeScript"
        }

        createAppFn -> methodOfFn "calls"
        createAppFn -> allowForFn "calls"
        createAppFn -> rejectMethodFn "calls"
        allowForFn -> registeredMethodsFn "calls"
        startServerFn -> createAppFn "calls"
        methodOfFn -> httpMethodType "produces"
        createAppFn -> host.registry.createHostFn "calls"
        createAppFn -> host.registry.routeKeyFn "calls"
        registeredMethodsFn -> host.registry.hostRegistryType "consumes"
        allowForFn -> host.registry.hostRegistryType "consumes"
        createAppFn -> assetServer.serveFileFn "dispatches to"
      }
      assetServer = component "Asset server" {
        description "Serves package-registered static files from disk with content-type headers and caching control."
        technology "TypeScript"
        link ./src/server.ts "Source"

        serveFileFn = code "serveFile()" {
          description """
            Checks file existence with `access()`, then streams the file
            through `createReadStream().pipe(response)` with the given
            `content-type` and `cache-control: no-cache` headers.
            Falls back to 404 when the file is missing.
          """
          technology "TypeScript"
        }
      }
    }

    member = container "Member loader" {
      description "Loads developer-specific package manifests from external checkouts and scaffolds member packages."
      technology "TypeScript"
      link ./src/member.ts "Source"

      configLoader = component "Member config loader" {
        description "Reads and validates .resonance/member-config.json and resolves the external member repository path."
        technology "TypeScript"
        link ./src/member.ts "Source"

        memberConfigType = code "MemberConfig" {
          description """
            Config shape: `version` (manifest version), `source` (absolute path
            to member repository), and `packages` (id→PackageInput map).
          """
          technology "TypeScript"
        }
        validateMemberConfigFn = code "validateMemberConfig()" {
          description """
            Validates raw JSON into a `MemberConfig`: checks version, source,
            and packages fields, then resolves the source to an absolute path.
          """
          technology "TypeScript"
        }
        loadMemberConfigFn = code "loadMemberConfig()" {
          description """
            Reads `.resonance/member-config.json` from the repository root,
            parses and validates it, and returns `null` when the file is absent.
          """
          technology "TypeScript"
        }
        writeMemberConfigFn = code "writeMemberConfig()" {
          description """
            Validates a `MemberConfig`, creates the `.resonance/` directory,
            and writes the config atomically via temp-file + rename.
          """
          technology "TypeScript"
        }
        resolveMemberRepositoryFn = code "resolveMemberRepository()" {
          description """
            Resolves the configured member repository source path to its
            canonical realpath, validating it is absolute.
          """
          technology "TypeScript"
        }
        packageInputFn = code "packageInput()" {
          description """
            Strips `module` and `enabled` keys from a `PackageConfig`,
            producing a `PackageInput` suitable for the host registry.
          """
          technology "TypeScript"
        }

        loadMemberConfigFn -> validateMemberConfigFn "validates with"
        loadMemberConfigFn -> memberConfigType "produces"
        writeMemberConfigFn -> validateMemberConfigFn "validates with"
        writeMemberConfigFn -> memberConfigType "produces"
        validateMemberConfigFn -> memberConfigType "produces"
      }
      manifestLoader = component "Member manifest loader" {
        description "Discovers and loads the member package manifest from the external checkout."
        technology "TypeScript"
        link ./src/member.ts "Source"

        memberManifestType = code "MemberManifest" {
          description """
            Manifest shape: `version` (manifest version) and `packages`
            (id→PackageConfig map with required `module` field).
          """
          technology "TypeScript"
        }
        validateMemberManifestFn = code "validateMemberManifest()" {
          description """
            Validates raw JSON into a `MemberManifest`: checks version and
            ensures each package entry has a `module` string.
          """
          technology "TypeScript"
        }
        loadMemberManifestFn = code "loadMemberManifest()" {
          description """
            Discovers the member manifest by trying a priority-ordered list
            of candidate filenames, then reads, parses, and validates the
            first one found.
          """
          technology "TypeScript"
        }

        loadMemberManifestFn -> validateMemberManifestFn "validates with"
        loadMemberManifestFn -> memberManifestType "produces"
        validateMemberManifestFn -> memberManifestType "produces"
      }
    }

    scaffolder = container "Member scaffolder" {
      description "Generates member package templates and repository scaffolds with Git initialization."
      technology "TypeScript"
      link ./src/member-scaffold.ts "Source"

      memberRepositoryPlanType = code "MemberRepositoryPlan" {
        description """
          Frozen plan: `directory` (repository root) and `files`
          (all files that will be written).
        """
        technology "TypeScript"
      }
      memberPackagePlanType = code "MemberPackagePlan" {
        description """
          Frozen plan for a single package: `id`, `label`, `directory`,
          `files`, `manifestSnippet`, and `testFile`.
        """
        technology "TypeScript"
      }
      verifyMemberPackageType = code "VerifyMemberPackage" {
        description """
          Callback `(plan: MemberPackagePlan) => Promise<void>` that the
          caller supplies to run focused verification after scaffolding.
        """
        technology "TypeScript"
      }
      planMemberPackageScaffoldFn = code "planMemberPackageScaffold()" {
        description """
          Validates the package id, computes the output directory and file
          list, and returns a frozen `MemberPackagePlan` without writing.
        """
        technology "TypeScript"
      }
      createMemberPackageScaffoldFn = code "createMemberPackageScaffold()" {
        description """
          Calls `planMemberPackageScaffold()`, creates the package directory,
          writes all template files, runs the `verify` callback, and rolls
          back on failure.
        """
        technology "TypeScript"
      }
      planMemberRepositoryFn = code "planMemberRepository()" {
        description """
          Computes the repository directory and full file list (manifest,
          package.json, .gitignore, README, contract copy, authoring skill)
          without writing.
        """
        technology "TypeScript"
      }
      createMemberRepositoryFn = code "createMemberRepository()" {
        description """
          Calls `planMemberRepository()`, copies the package contract and
          authoring skill from the app root, writes all repository files,
          runs `git init`, and rolls back on failure.
        """
        technology "TypeScript"
      }

      planMemberPackageScaffoldFn -> memberPackagePlanType "produces"
      createMemberPackageScaffoldFn -> planMemberPackageScaffoldFn "calls"
      createMemberPackageScaffoldFn -> verifyMemberPackageType "calls"
      createMemberRepositoryFn -> planMemberRepositoryFn "calls"
      planMemberRepositoryFn -> memberRepositoryPlanType "produces"
    }

    content = container "Content engine" {
      description "Provides shared Markdown rendering, file discovery, and document tree building used by the Home and Docs packages."
      technology "TypeScript + markdown-it"
      link ./src/markdown.ts "Source"

      markdownRenderer = component "Markdown renderer" {
        description "Wraps markdown-it to convert Markdown source into HTML with configurable options."
        technology "TypeScript + markdown-it"
        link ./src/markdown.ts "Source"

        createMarkdownRendererFn = code "createMarkdownRenderer()" {
          description """
            Factory that creates a configured `markdown-it` instance with optional
            override of `html`, `linkify`, and `typographer` flags.
          """
          technology "TypeScript"
        }
        renderMarkdownFn = code "renderMarkdown()" {
          description """
            Convenience function that calls `createMarkdownRenderer()` with defaults
            and renders the given Markdown source to HTML.
          """
          technology "TypeScript"
        }

        renderMarkdownFn -> createMarkdownRendererFn "calls"
      }
      fileDiscovery = component "File discovery" {
        description "Recursively scans the repository for Markdown files, builds a sorted folder/file tree, and reads document content."
        technology "TypeScript"
        link ./src/content.ts "Source"

        discoverMarkdownFilesFn = code "discoverMarkdownFiles()" {
          description """
            Recursively walks a directory tree, filtering for Markdown file extensions
            and skipping ignored directories, returning a sorted array of POSIX-relative paths.
          """
          technology "TypeScript"
        }
        buildMarkdownTreeFn = code "buildMarkdownTree()" {
          description """
            Accepts a sorted array of file paths and builds a nested folder/file tree
            with `type`, `name`, `path`, and `children` fields for UI rendering.
          """
          technology "TypeScript"
        }
        readMarkdownFn = code "readMarkdown()" {
          description """
            Reads a Markdown file from disk at a repository-relative path
            and returns its UTF-8 content.
          """
          technology "TypeScript"
        }
        toPathFn = code "toPath()" {
          description """
            Converts a string or URL to a platform file path.
            Internal helper used by `discoverMarkdownFiles()` and `readMarkdown()`.
          """
          technology "TypeScript"
        }
        discoveryOptionsType = code "DiscoveryOptions" {
          description """
            Optional filter config: `extensions` (default `.md`, `.markdown`)
            and `ignoredDirectories` (default `.git`, `node_modules`).
          """
          technology "TypeScript"
        }
        defaultConstantsType = code "Default constants" {
          description """
            `DEFAULT_MARKDOWN_EXTENSIONS` = `['.md', '.markdown']`
            `DEFAULT_IGNORED_DIRECTORIES` = `['.git', 'node_modules']`
          """
          technology "TypeScript"
        }

        discoverMarkdownFilesFn -> toPathFn "calls"
        readMarkdownFn -> toPathFn "calls"
        discoverMarkdownFilesFn -> discoveryOptionsType "accepts"
        discoverMarkdownFilesFn -> defaultConstantsType "uses defaults from"
      }
    }

    config = container "Repository config" {
      description "Creates, validates, loads, and persists the repository manifest (.resonance/config.json) that drives package allowlisting and workspace configuration."
      technology "TypeScript"
      link ./src/config.ts "Source"

      configFactory = component "Config factory" {
        description "Assembles RepositoryConfig objects with sensible defaults for shell, home, and docs packages."
        technology "TypeScript"
        link ./src/config.ts "Source"

        createRepoConfigFn = code "createRepositoryConfig()" {
          description """
            Assembles a RepositoryConfig from optional flags (`home`, `docs`)
            and metadata, applying defaults for shell/home/docs package entries
            and the manifest version.
          """
          technology "TypeScript"
        }
        defaultRepoConfigFn = code "defaultRepositoryConfig()" {
          description """
            Convenience wrapper that calls `createRepositoryConfig()` with no
            arguments, returning the baseline factory config.
          """
          technology "TypeScript"
        }

        defaultRepoConfigFn -> createRepoConfigFn "calls"
      }
      configValidator = component "Config validator" {
        description "Validates the structure and types of a loaded or in-memory RepositoryConfig against the manifest schema."
        technology "TypeScript"
        link ./src/config.ts "Source"

        validateRepoConfigFn = code "validateRepositoryConfig()" {
          description """
            Top-level validator: checks that the value is an object, asserts
            MANIFEST_VERSION, delegates to `validateRepositoryMetadata()` and
            `validatePackageInputs()`, and returns a typed RepositoryConfig.
          """
          technology "TypeScript"
        }
        validatePackageInputsFn = code "validatePackageInputs()" {
          description """
            Validates the `packages` object: ensures entries are records,
            checks `enabled` and `module` types, and returns a typed
            Record<string, PackageConfig>.
          """
          technology "TypeScript"
        }
        validateRepoMetadataFn = code "validateRepositoryMetadata()" {
          description """
            Validates the optional `repository` metadata block: checks
            object shape and validates `name` and `tagline` string types,
            returning a pruned RepositoryConfigMetadata or undefined.
          """
          technology "TypeScript"
        }

        validateRepoConfigFn -> validateRepoMetadataFn "calls"
        validateRepoConfigFn -> validatePackageInputsFn "calls"
      }
      configPersistence = component "Config persistence" {
        description "Reads, writes, and checks existence of .resonance/config.json on disk with atomic writes."
        technology "TypeScript"
        link ./src/config.ts "Source"

        writeRepoConfigFn = code "writeRepositoryConfig()" {
          description """
            Validates the supplied config, creates the `.resonance/` directory,
            and writes the JSON-serialised config atomically (with trailing
            newline) to `.resonance/config.json`.
          """
          technology "TypeScript"
        }
        loadRepoConfigFn = code "loadRepositoryConfig()" {
          description """
            Reads `.resonance/config.json` from disk, parses the JSON, and
            validates it through `validateRepositoryConfig()`. Throws on
            missing file, invalid JSON, or schema mismatch.
          """
          technology "TypeScript"
        }
        repoConfigExistsFn = code "repositoryConfigExists()" {
          description """
            Checks whether `.resonance/config.json` exists on disk at the
            given repository root. Returns `true`/`false`; re-throws
            non-ENOENT errors.
          """
          technology "TypeScript"
        }

        writeRepoConfigFn -> configValidator.validateRepoConfigFn "validates with"
        loadRepoConfigFn -> configValidator.validateRepoConfigFn "validates with"
      }

      configFactory -> configValidator "assembles valid config via"
      configPersistence -> configValidator "validates with"
    }

    browser = browser "Browser" {
      description "Client-side application runtime that loads the shell bootstrap, renders package UIs, manages navigation, and communicates with the server via HTTP and SSE."
      technology "JavaScript + HTML + CSS"
    }
  }

  resonancePackages = system "Resonance Packages" {
    description "Pluggable packages that extend the workspace with domain-specific capabilities. Packages register through the Runtime host and may read repository sources or make LLM calls."

    shell = container "Shell" {
      description "Owns the browser frame, navigation, mounts, and bootstrap."
      technology "TypeScript"
      link ./src/packages/shell/index.ts "Source"

      htmlFrame = component "HTML shell" {
        description "Serves the index.html page that defines the application frame, navigation skeleton, and package mount points."
        technology "HTML"
        link ./src/packages/shell/index.html "Source"
      }
      appBootstrap = component "Application bootstrap" {
        description "Serves the shell JavaScript entrypoint that initialises the client-side router, mounts, and navigation controller."
        technology "TypeScript"
        link ./src/packages/shell/app.js "Source"

        startApplicationFn = code "startApplication()" {
          description """
            Exported entry point: fetches the manifest, renders repository
            metadata, creates the shell, loads package stylesheets, imports
            and mounts browser packages, renders workspace navigation, and
            activates Home when available (otherwise the first workspace).
            Returns `{ manifest, packages, activate }`.
          """
          technology "TypeScript"
        }
        loadStylesheetFn = code "loadStylesheet()" {
          description """
            Conditionally appends a package-specific `<link>` stylesheet to the
            document head, de-duplicating by `data-package-style` attribute.
          """
          technology "TypeScript"
        }
        renderRepoMetadataFn = code "renderRepositoryMetadata()" {
          description """
            Populates DOM elements decorated with `data-shell-*` attributes
            (repository name, version, tagline, runtime version) from the
            manifest payload.
          """
          technology "TypeScript"
        }
        createShellFn = code "createShell()" {
          description """
            Factory imported from shell.js: creates the navigation controller,
            mount-region manager, and package lifecycle (register, activate,
