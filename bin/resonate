#!/usr/bin/env bun

import process from 'node:process';
import { readFile, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createInterface, clearLine, cursorTo, moveCursor } from 'node:readline';
import { openBrowser } from '../src/browser.ts';
import { createRepositoryConfig, loadRepositoryConfig, repositoryConfigExists, writeRepositoryConfig } from '../src/config.ts';
import { startServer } from '../src/server.ts';
import { createPackageScaffold, planPackageScaffold } from '../src/package-scaffold.ts';
import { loadMemberManifest, resolveMemberRepository, writeMemberConfig } from '../src/member.ts';
import { createMemberPackageScaffold, createMemberRepository, planMemberPackageScaffold, planMemberRepository } from '../src/member-scaffold.ts';

const applicationRoot = fileURLToPath(new URL('../', import.meta.url));

function printHelp(log = console.log) {
  log(`resonate — local environment for repository Markdown

Usage:
  resonate [options]
  resonate install
  resonate package create <id>
  resonate member init <folder>
  resonate member install <member-repository>
  resonate member package create <id>

Commands:
  install              Set up Resonance in the current repository
  package create <id>  Create a package starter below the Resonance application root
  member init <folder>    Bootstrap a member-package repository
  member install <path>   Register and select packages from an external member repository
  member package create <id> Create a package in the current member repository

Options:
  --port <number>  Port to listen on (default: 4317)
  --host <host>    Host to bind (default: 127.0.0.1)
  --help           Show this help
`);
}

export function parseArgs(argumentsList) {
  const options = { command: null, packageId: null, port: Number(process.env.RESONANCE_PORT || 4317), host: process.env.RESONANCE_HOST || '127.0.0.1' };
  let index = 0;
  if (argumentsList[0] === 'install') { options.command = 'install'; index = 1; }
  else if (argumentsList[0] === 'package') {
    if (argumentsList[1] !== 'create') throw new Error(`Unknown package command: ${argumentsList[1] || '(missing)'}`);
    if (!argumentsList[2] || argumentsList[2].startsWith('--')) throw new Error('Package create requires an <id>.');
    options.command = 'package-create'; options.packageId = argumentsList[2]; index = 3;
  } else if (argumentsList[0] === 'member') {
    if (argumentsList[1] === 'init') {
      if (!argumentsList[2] || argumentsList[2].startsWith('--')) throw new Error('Member init requires a <folder>.');
      options.command = 'member-init'; options.memberSource = argumentsList[2]; index = 3;
    } else if (argumentsList[1] === 'install') {
      if (!argumentsList[2] || argumentsList[2].startsWith('--')) throw new Error('Member install requires a <member-repository>.');
      options.command = 'member-install'; options.memberSource = argumentsList[2]; index = 3;
    } else if (argumentsList[1] === 'package' && argumentsList[2] === 'create') {
      if (!argumentsList[3] || argumentsList[3].startsWith('--')) throw new Error('Member package create requires an <id>.');
      options.command = 'member-package-create'; options.packageId = argumentsList[3]; index = 4;
    } else throw new Error(`Unknown member command: ${argumentsList[1] || '(missing)'}`);
  }
  for (; index < argumentsList.length; index += 1) {
    const argument = argumentsList[index];
    if (argument === '--help' || argument === '-h') return { help: true };
    if (argument === '--port') options.port = Number(argumentsList[++index]);
    else if (argument === '--host') options.host = argumentsList[++index];
    else if (argument.startsWith('--')) throw new Error(`Unknown option: ${argument}`);
    else throw new Error(`Unexpected argument: ${argument}`);
  }
  if (!Number.isInteger(options.port) || options.port < 0 || options.port > 65535) throw new Error('Port must be an integer between 0 and 65535.');
  return options;
}

export async function runFocusedPackageTest(plan, { appRoot = applicationRoot, spawnFn = Bun.spawn } = {}) {
  const child = spawnFn(['bun', 'test', plan.testFile], { cwd: appRoot, stdout: 'inherit', stderr: 'inherit' });
  const exitCode = await child.exited;
  if (exitCode !== 0) throw new Error(`Focused package test failed with exit code ${exitCode}.`);
}

function logPackagePlan(plan, appRoot, log) {
  log(`Package files to create for ${plan.id}:`);
  for (const filename of plan.files) log(`  ${path.relative(appRoot, filename)}`);
}
function logMemberRepositoryPlan(plan, log) {
  log(`Member repository files to create in ${plan.directory}:`);
  for (const filename of plan.files) log(`  ${path.relative(plan.directory, filename)}`);
}

function askQuestion(prompt, question) {
  return new Promise((resolve) => prompt.question(question, resolve));
}

function createInputLineReader(input) {
  let buffer = ''; let ended = false; const lines = []; const waiters = [];
  const deliver = () => { while (lines.length > 0 && waiters.length > 0) waiters.shift()(lines.shift()); };
  const onData = (chunk) => { buffer += String(chunk); const parts = buffer.split(/\r?\n/); buffer = parts.pop(); lines.push(...parts); deliver(); };
  const onEnd = () => { if (buffer) lines.push(buffer); buffer = ''; ended = true; while (waiters.length > 0) waiters.shift()(''); deliver(); };
  input.on('data', onData); input.once('end', onEnd);
  return { next: () => { if (lines.length > 0) return Promise.resolve(lines.shift()); if (ended) return Promise.resolve(''); return new Promise((resolve) => waiters.push(resolve)); }, close: () => { input.off('data', onData); input.off('end', onEnd); } };
}

export async function askToInstall({ input = process.stdin, output = process.stdout } = {}) {
  if (!input.isTTY) {
    const reader = createInputLineReader(input);
    output.write('Would you like to install Resonance in this repository? [y/N] ');
    try { return /^(y|yes)$/i.test((await reader.next()).trim()); } finally { reader.close(); }
  }
  const prompt = createInterface({ input, output });
  try { return /^(y|yes)$/i.test((await askQuestion(prompt, 'Would you like to install Resonance in this repository? [y/N] ')).trim()); }
  finally { prompt.close(); input.resume?.(); }
}

const OPTIONAL_PACKAGES = [{ id: 'home', label: 'Home (README.md)' }, { id: 'docs', label: 'Docs' }];

export async function selectMemberPackages({ manifest, input = process.stdin, output = process.stdout } = {}) {
  const packages = Object.entries(manifest.packages).map(([id, value]) => ({ id, label: value.label || id }));
  if (!input.isTTY || !output.isTTY || typeof input.setRawMode !== 'function') {
    const reader = createInputLineReader(input); const selected = {};
    try { for (const item of packages) { output.write(`Install ${item.label}? [y/N] `); if (/^(y|yes)$/i.test((await reader.next()).trim())) selected[item.id] = {}; } return selected; }
    finally { reader.close(); }
  }
  return new Promise((resolve) => {
    let cursor = 0; const selected = Object.fromEntries(packages.map((item) => [item.id, false])); let rendered = false; let inputBuffer = '';
    const render = () => { if (rendered) moveCursor(output, 0, -packages.length); for (const [index, item] of packages.entries()) { cursorTo(output, 0); clearLine(output, 0); output.write(`${index === cursor ? '❯' : ' '} [${selected[item.id] ? 'x' : ' '}] ${item.label}\n`); } rendered = true; };
    const finish = (cancelled) => { input.setRawMode(false); input.off('data', onData); if (!cancelled) output.write('\n'); resolve(cancelled ? null : Object.fromEntries(Object.entries(selected).filter(([, value]) => value).map(([id]) => [id, {}]))); };
    const onData = (chunk) => { inputBuffer += String(chunk); while (inputBuffer.length > 0) { if (inputBuffer.startsWith('\x1b[') && inputBuffer.length < 3) return; let action = inputBuffer[0]; if (inputBuffer.startsWith('\x1b[A') || inputBuffer.startsWith('\x1b[D')) { action = 'up'; inputBuffer = inputBuffer.slice(3); } else if (inputBuffer.startsWith('\x1b[B') || inputBuffer.startsWith('\x1b[C')) { action = 'down'; inputBuffer = inputBuffer.slice(3); } else inputBuffer = inputBuffer.slice(1); if (action === '\x03' || action === '\x04' || action === '\x1b') { finish(true); return; } if (action === 'up') cursor = (cursor + packages.length - 1) % packages.length; else if (action === 'down') cursor = (cursor + 1) % packages.length; else if (action === ' ') selected[packages[cursor].id] = !selected[packages[cursor].id]; else if (action === '\r' || action === '\n') { finish(false); return; } else continue; render(); } };
    output.write('Select member packages (↑/↓ to move, space to select, enter to continue):\n'); input.setRawMode(true); input.on('data', onData); render();
  });
}

function checkboxLines(cursor, selected) {
  return OPTIONAL_PACKAGES.map((item, index) => `${index === cursor ? '❯' : ' '} [${selected[item.id] ? 'x' : ' '}] ${item.label}`);
}

export async function selectOptionalPackages({ input = process.stdin, output = process.stdout } = {}) {
  output.write('Shell package is required and will always be installed.\n');
  if (!input.isTTY || !output.isTTY || typeof input.setRawMode !== 'function') {
    const reader = createInputLineReader(input);
    output.write('Install Home package? [y/N] ');
    try {
      const home = /^(y|yes)$/i.test((await reader.next()).trim());
      output.write('Install Docs package? [y/N] ');
      const docs = /^(y|yes)$/i.test((await reader.next()).trim());
      return { home, docs };
    } finally { reader.close(); }
  }

  return new Promise((resolve) => {
    let cursor = 0; const selected = { home: false, docs: false }; let rendered = false; let inputBuffer = '';
    const render = () => {
      if (rendered) moveCursor(output, 0, -OPTIONAL_PACKAGES.length);
      for (const line of checkboxLines(cursor, selected)) { cursorTo(output, 0); clearLine(output, 0); output.write(line); output.write('\n'); }
      rendered = true;
    };
    const finish = (result) => {
      input.setRawMode(false); input.off('data', onData); output.write('\n'); resolve(result);
    };
    const onData = (chunk) => {
      inputBuffer += String(chunk);
      while (inputBuffer.length > 0) {
        if (inputBuffer.startsWith('\x1b[') && inputBuffer.length < 3) return;
        let action = inputBuffer[0];
        if (inputBuffer.startsWith('\x1b[A') || inputBuffer.startsWith('\x1b[D')) { action = 'up'; inputBuffer = inputBuffer.slice(3); }
        else if (inputBuffer.startsWith('\x1b[B') || inputBuffer.startsWith('\x1b[C')) { action = 'down'; inputBuffer = inputBuffer.slice(3); }
        else { inputBuffer = inputBuffer.slice(1); }
        if (action === '\x03' || action === '\x04' || action === '\x1b') { finish(null); return; }
        if (action === 'up') cursor = (cursor + OPTIONAL_PACKAGES.length - 1) % OPTIONAL_PACKAGES.length;
        else if (action === 'down') cursor = (cursor + 1) % OPTIONAL_PACKAGES.length;
        else if (action === ' ') selected[OPTIONAL_PACKAGES[cursor].id] = !selected[OPTIONAL_PACKAGES[cursor].id];
        else if (action === '\r' || action === '\n') { finish(selected); return; }
        else continue;
        render();
      }
    };
    output.write('Select optional packages (↑/↓ to move, space to select, enter to continue):\n');
    input.setRawMode(true); input.on('data', onData); render();
  });
}

export async function installRepository(root, { selectPackagesFn = selectOptionalPackages, log = console.log } = {}) {
  if (await repositoryConfigExists(root)) {
    log('Resonance is already installed in this repository.');
    return loadRepositoryConfig(root);
  }
  const selection = await selectPackagesFn();
  if (!selection) { log('Installation cancelled.'); return null; }
  const config = await writeRepositoryConfig(root, createRepositoryConfig({ ...selection, root }));
  log(`Resonance installed in ${root}.`);
  return config;
}

async function addMemberGitignore(root) {
  const filename = path.join(root, '.gitignore');
  let current = '';
  try { current = await readFile(filename, 'utf8'); } catch (error) { if (error?.code !== 'ENOENT') throw error; }
  const entries = ['.resonance/member-config.json', '.resonance/member-state/'];
  const lines = current.split(/\\r?\\n/);
  for (const entry of entries) if (!lines.includes(entry)) lines.push(entry);
  while (lines.length > 0 && lines.at(-1) === '') lines.pop();
  await writeFile(filename, `${lines.join('\\n')}\\n`, 'utf8');
}

export async function installMemberPackages(root, source, { selectPackagesFn = selectMemberPackages, log = console.log } = {}) {
  const memberRoot = await resolveMemberRepository(source);
  const manifest = await loadMemberManifest(memberRoot);
  const selection = await selectPackagesFn({ manifest, source: memberRoot });
  if (!selection) { log('Member package installation cancelled.'); return null; }
  const packages = Array.isArray(selection) ? Object.fromEntries(selection.map((id) => [id, {}])) : selection;
  const config = await writeMemberConfig(root, { version: 1, source: memberRoot, packages });
  await addMemberGitignore(root);
  log(`Member packages registered from ${memberRoot}.`);
  return config;
}

export async function run(argumentsList, { root = process.cwd(), appRoot = applicationRoot, startServerFn = startServer, openBrowserFn = openBrowser, log = console.log, isInstalledFn = repositoryConfigExists, confirmInstallFn = askToInstall, selectPackagesFn = selectOptionalPackages, selectMemberPackagesFn = selectMemberPackages, installMemberPackagesFn = installMemberPackages, createMemberRepositoryFn = createMemberRepository, planMemberRepositoryFn = planMemberRepository, planMemberPackageScaffoldFn = planMemberPackageScaffold, createMemberPackageScaffoldFn = createMemberPackageScaffold, loadConfigFn = loadRepositoryConfig, planPackageScaffoldFn = planPackageScaffold, createPackageScaffoldFn = createPackageScaffold, runFocusedTestFn = runFocusedPackageTest } = {}) {
  const options = parseArgs(argumentsList);
  if (options.help) { printHelp(log); return null; }
  if (options.command === 'install') { await installRepository(root, { selectPackagesFn, log }); return null; }
  if (options.command === 'member-init') {
    const plan = planMemberRepositoryFn({ directory: options.memberSource }); logMemberRepositoryPlan(plan, log);
    await createMemberRepositoryFn({ directory: options.memberSource, appRoot });
    log(`Created member repository ${plan.directory}.`); log('Run `resonate member package create <id>` from that repository.'); return null;
  }
  if (options.command === 'member-install') { await installMemberPackagesFn(root, options.memberSource, { selectPackagesFn: selectMemberPackagesFn, log }); return null; }
  if (options.command === 'member-package-create') {
    const plan = planMemberPackageScaffoldFn({ memberRoot: root, id: options.packageId }); logPackagePlan(plan, root, log);
    const created = await createMemberPackageScaffoldFn({ memberRoot: root, id: options.packageId, verify: (scaffoldPlan) => runFocusedTestFn(scaffoldPlan, { appRoot: root }) });
    log(`Created member package ${created.id}.`); log('Add this explicit entry to member-packages.json:'); log(created.manifestSnippet); log('Full regression: bun test'); return null;
  }
  if (options.command === 'package-create') {
    const plan = planPackageScaffoldFn({ appRoot, id: options.packageId });
    logPackagePlan(plan, appRoot, log);
    const created = await createPackageScaffoldFn({ appRoot, id: options.packageId, verify: (scaffoldPlan) => runFocusedTestFn(scaffoldPlan, { appRoot }) });
    log(`Created package ${created.id}.`);
    log('Focused package test passed.');
    log('Add this explicit entry to the viewed repository manifest:');
    log(created.manifestSnippet);
    log('Full regression: bun test');
    return null;
  }
  if (!await isInstalledFn(root)) {
    log('Resonance is not installed in this repository.');
    if (!await confirmInstallFn()) { log('Installation cancelled.'); return null; }
    const installed = await installRepository(root, { selectPackagesFn, log });
    if (!installed) return null;
  }
  const config = await loadConfigFn(root);
  const { command: _command, packageId: _packageId, ...serverOptions } = options;
  const server = await startServerFn({ root, config, ...serverOptions });
  const address = server.address();
  const visibleHost = options.host === '0.0.0.0' ? '127.0.0.1' : options.host;
  const url = `http://${visibleHost}:${address.port}`;
  log(`resonate serving ${root}`); log(url); openBrowserFn(url);
  return server;
}

if (import.meta.url === `file://${process.argv[1]}` || process.argv[1]?.endsWith('/resonate')) {
  try {
    const server = await run(process.argv.slice(2));
    if (!server) process.exit(0);
    const shutdown = () => server.close(() => process.exit(0));
    process.once('SIGINT', shutdown); process.once('SIGTERM', shutdown);
  } catch (error) { console.error(`resonate: ${error.message}`); process.exit(1); }
}
