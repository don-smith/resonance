{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.14.0 <11"
  },
  "scripts": {
    "desktop:dev": "node --experimental-strip-types --no-warnings scripts/desktop-dev.ts",
    "desktop:profiles": "node --experimental-strip-types --no-warnings scripts/desktop-profiles.ts",
    "packages:generate": "node --experimental-strip-types --no-warnings scripts/bundled-package-catalog.ts write",
    "packages:boundaries": "node --experimental-strip-types --no-warnings scripts/bundled-package-boundaries.ts",
    "packages:check": "node --experimental-strip-types --no-warnings scripts/bundled-package-catalog.ts check && node --experimental-strip-types --no-warnings scripts/bundled-package-boundaries.ts",
    "web:build": "pnpm --filter @resonance/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "rust:check": "cargo fmt --all -- --check && cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace -- -D warnings",
    "build:desktop": "pnpm --filter @resonance/desktop tauri build --debug",
    "release:validate": "node --experimental-strip-types --no-warnings scripts/validate-release-config.ts",
    "release:manifest": "node --experimental-strip-types --no-warnings scripts/generate-update-manifest.ts",
    "release:collect": "node --experimental-strip-types --no-warnings scripts/collect-signed-update-artifacts.ts",
    "check": "pnpm packages:check && pnpm format:check && pnpm typecheck && pnpm web:build && pnpm test && pnpm rust:check && pnpm rust:test && pnpm rust:clippy"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "22.15.3",
    "parse5": "8.0.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
