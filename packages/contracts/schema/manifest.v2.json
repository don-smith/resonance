{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/package-manifest.v2.json",
  "title": "Resonance package manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "source",
    "id",
    "name",
    "description",
    "nav",
    "content",
    "events",
    "minRole"
  ],
  "properties": {
    "manifestVersion": { "const": 2 },
    "source": { "const": "bundled" },
    "id": {
      "type": "string",
      "pattern": "^(resonance|[a-z][a-z0-9-]*)\\.[a-z][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "icon"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*\\.ts$"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emits", "consumes"],
      "properties": {
        "emits": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventName" },
          "uniqueItems": true
        },
        "consumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventName" },
          "uniqueItems": true
        }
      }
    },
    "minRole": { "enum": ["viewer", "contributor", "developer"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "documents:read",
          "documents:write",
          "workspace:read",
          "repository:read",
          "telemetry:write",
          "workspace-files:v1",
          "conversations:v1"
        ]
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemPrompt", "permissions", "contextProviders"],
      "properties": {
        "systemPrompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*\\.md$"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "suggest-edits",
              "apply-edits",
              "create-documents",
              "post-messages"
            ]
          }
        },
        "contextProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "eventName": {
      "type": "string",
      "pattern": "^(repo:changed|doc:updated|doc:opened|message:received|peer:joined|peer:left|peer:connection|workspace:member-added|workspace:member-removed|conversations:changed|agent-context:[a-z][a-z0-9-]*|[a-z][a-z0-9-]*:[a-z][a-z0-9-]*)$"
    }
  }
}
